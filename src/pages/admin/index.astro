---
import AdminDash from '../../components/AdminDash';
import '../../styles/global.css';
import {validSession} from '../../server/auth';
import {listApps} from '../../server/packages';

export const prerender = false;

if (!validSession(Astro.request.headers.get('cookie'))) {
  return Astro.redirect('/admin/login/');
}
const apps = listApps();
const err = Astro.url.searchParams.get('err') ?? '';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>后台</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <header class="border-b border-line bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
        <p class="font-semibold">后台</p>
        <div class="flex gap-3 text-sm">
          <a class="rounded-full border border-line px-3 py-1.5" href="/">站点</a>
          <a class="rounded-full border border-line px-3 py-1.5" href="/download/">下载页</a>
          <form method="post" action="/api/admin/logout/">
            <button class="rounded-full bg-ink px-3 py-1.5 text-white" type="submit">退出</button>
          </form>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-5xl space-y-10 px-5 py-8">
      {err && <p class="rounded-2xl bg-red-50 px-4 py-2 text-sm text-red-700">{err}</p>}
      <AdminDash client:load />
      <section class="rounded-3xl border border-line bg-white p-5">
        <h2 class="text-lg font-semibold">下载页安装包</h2>
        <p class="mt-1 text-sm text-mute">图标、名称、多个版本标注。会出现在公开下载页。</p>
        <form class="mt-5 grid gap-3 sm:grid-cols-[1fr_auto_auto] sm:items-end" method="post" action="/api/admin/packages/" enctype="multipart/form-data">
          <input type="hidden" name="action" value="create" />
          <label class="text-sm">名称
            <input class="mt-1 w-full rounded-xl border border-line px-3 py-2" name="name" required />
          </label>
          <label class="text-sm">图标
            <input class="mt-1 w-full text-sm" type="file" name="icon" accept="image/*" required />
          </label>
          <button class="rounded-full bg-ink px-4 py-2 text-sm text-white" type="submit">新建应用</button>
        </form>
        <ul class="mt-8 space-y-8">
          {apps.map((app) => (
            <li class="border-t border-line pt-6">
              <div class="flex items-center gap-3">
                <img class="size-12 rounded-xl border border-line object-cover" src={`/api/packages/?kind=icon&app=${app.id}`} alt="" />
                <div>
                  <p class="font-medium">{app.name}</p>
                  <p class="text-sm text-mute">{app.versions.length} 个版本</p>
                </div>
                <form class="ml-auto" method="post" action="/api/admin/packages/">
                  <input type="hidden" name="action" value="delete-app" />
                  <input type="hidden" name="appId" value={app.id} />
                  <button class="text-sm text-mute underline" type="submit">删除应用</button>
                </form>
              </div>
              <ul class="mt-3 space-y-2 text-sm">
                {app.versions.map((version) => (
                  <li class="flex items-center gap-3">
                    <span class="rounded-full bg-paper px-2 py-0.5">{version.label}</span>
                    <span class="text-mute">{Math.round(version.size / 1024)} KB</span>
                    <a class="underline" href={`/api/packages/?kind=file&app=${app.id}&ver=${version.id}`}>下载</a>
                    <form method="post" action="/api/admin/packages/">
                      <input type="hidden" name="action" value="delete-version" />
                      <input type="hidden" name="appId" value={app.id} />
                      <input type="hidden" name="versionId" value={version.id} />
                      <button class="text-mute underline" type="submit">删</button>
                    </form>
                  </li>
                ))}
              </ul>
              <form class="mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" method="post" action="/api/admin/packages/" enctype="multipart/form-data">
                <input type="hidden" name="action" value="version" />
                <input type="hidden" name="appId" value={app.id} />
                <label class="text-sm">版本标注
                  <input class="mt-1 w-full rounded-xl border border-line px-3 py-2" name="label" placeholder="1.0 Windows" required />
                </label>
                <label class="text-sm">安装包
                  <input class="mt-1 w-full text-sm" type="file" name="file" required />
                </label>
                <button class="rounded-full border border-ink px-4 py-2 text-sm" type="submit">加版本</button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
