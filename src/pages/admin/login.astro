---
import '../../styles/global.css';
import {validSession} from '../../server/auth';

export const prerender = false;

if (validSession(Astro.request.headers.get('cookie'))) {
  return Astro.redirect('/admin/');
}
const bad = Astro.url.searchParams.get('bad') === '1';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>后台登录</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="grid min-h-screen place-items-center bg-paper text-ink">
    <form class="w-full max-w-sm rounded-3xl border border-line bg-white p-6" method="post" action="/api/admin/login/">
      <h1 class="text-xl font-semibold">后台</h1>
      <p class="mt-2 text-sm text-mute">输入口令进入管理页。</p>
      {bad && <p class="mt-3 text-sm text-red-600">口令不对。</p>}
      <label class="mt-5 block text-sm">
        口令
        <input class="mt-1 w-full rounded-xl border border-line px-3 py-2" type="password" name="password" required />
      </label>
      <button class="mt-5 w-full rounded-full bg-ink py-2 text-sm text-white" type="submit">进入</button>
    </form>
  </body>
</html>
