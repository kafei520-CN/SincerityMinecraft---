---
import HolographicCard from '../../holographic-card/index.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import {categories, siteDescription, siteName, tools} from '../tools/catalog';

const band = Array.from({length: 6}, () => tools).flat();
const cardTools = tools.map((tool) => ({
  id: tool.id,
  name: tool.name,
  category: categories.find((item) => item.id === tool.categoryId)?.name ?? '',
}));
---

<BaseLayout title={siteName} description={siteDescription} poster>
  <section class="grid flex-1 items-stretch gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(20rem,0.8fr)] lg:gap-12">
    <div class="flex flex-col lg:min-h-[calc(100vh-16rem)]">
      <p class="text-sm tracking-[0.22em] text-mute">SINCERITY MINECRAFT</p>
      <h1 class="mt-5 text-[clamp(4.5rem,13vw,11rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
        <span class="block">工具</span>
        <span class="block">聚合站</span>
      </h1>
      <p class="mt-8 max-w-md text-lg leading-8 text-mute">
        坐标、时间、经验，收成一页。打开就能算，输入留在这台浏览器里。
      </p>
    </div>
    <div class="holo-slot relative flex min-h-[36rem] overflow-hidden rounded-[2rem] bg-[#090a0c] lg:min-h-[calc(100vh-16rem)]">
      <HolographicCard client:only="react" tools={cardTools} />
    </div>
  </section>
  <div class="mt-8 overflow-hidden border-y border-line py-4" aria-label="工具名">
    <div class="ticker-track">
      <ul class="flex gap-12 pr-12">
        {band.map((tool) => (
          <li>
            <a class="text-sm font-medium whitespace-nowrap" href={`/tools/${tool.id}/`}>
              {tool.name}
            </a>
          </li>
        ))}
      </ul>
      <ul class="flex gap-12 pr-12" aria-hidden="true">
        {band.map((tool) => (
          <li>
            <span class="text-sm font-medium whitespace-nowrap">{tool.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .holo-slot > astro-island {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
    min-height: 100%;
  }
</style>
