---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {listApps} from '../../server/packages';

export const prerender = false;

const apps = listApps();
---
<BaseLayout title="下载" description="安装包和版本。">
  <p class="text-sm text-mute">下载</p>
  <h1 class="mt-3 text-3xl font-semibold">安装包</h1>
  <p class="mt-3 max-w-xl text-mute">后台上传的应用会出现在这里，每个版本单独标注。</p>
  {apps.length === 0 ? (
    <p class="mt-10 text-mute">还没有安装包。</p>
  ) : (
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {apps.map((app) => (
        <li class="rounded-3xl border border-line bg-white p-5">
          <div class="flex items-center gap-3">
            <img class="size-14 rounded-2xl border border-line object-cover" src={`/api/packages/?kind=icon&app=${app.id}`} alt="" />
            <h2 class="text-lg font-semibold">{app.name}</h2>
          </div>
          <ul class="mt-4 space-y-2">
            {app.versions.length === 0 && <li class="text-sm text-mute">还没有版本</li>}
            {app.versions.map((version) => (
              <li>
                <a class="flex items-center justify-between rounded-2xl border border-line px-3 py-2 text-sm hover:border-ink" href={`/api/packages/?kind=file&app=${app.id}&ver=${version.id}`}>
                  <span>{version.label}</span>
                  <span class="text-mute">{Math.round(version.size / 1024)} KB</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
