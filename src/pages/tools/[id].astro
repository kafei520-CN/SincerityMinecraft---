---
import FavoriteButton from '../../components/FavoriteButton';
import RememberTool from '../../components/RememberTool';
import {ToolCapsule} from '../../components/ToolCapsule';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import CommandWidget from '../../tools/command-gen/Widget';
import DayClockWidget from '../../tools/day-clock/Widget';
import MotdWidget from '../../tools/motd/Widget';
import NetherCoordsWidget from '../../tools/nether-coords/Widget';
import SeedFinderWidget from '../../tools/seed-finder/Widget';
import ServerStatusWidget from '../../tools/server-status/Widget';
import SkinPreviewWidget from '../../tools/skin-preview/Widget';
import SkinRenderWidget from '../../tools/skin-render/Widget';
import TickTimeWidget from '../../tools/tick-time/Widget';
import UuidSkinWidget from '../../tools/uuid-skin/Widget';
import XpLevelWidget from '../../tools/xp-level/Widget';
import {categoryById, relatedTools, toolById} from '../../tools/catalog';

const id = Astro.params.id ?? '';
const tool = toolById(id);
if (!tool) {
  Astro.response.status = 404;
}
const category = tool ? categoryById(tool.categoryId) : undefined;
const related = tool ? relatedTools(tool) : [];
---

{tool?.id === 'skin-render' ? (
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title> </title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="h-dvh overflow-hidden bg-[#111418]">
    <SkinRenderWidget client:load />
  </body>
</html>
) : tool ? (
<BaseLayout title={tool.name} description={tool.summary}>
  <RememberTool client:load toolId={tool.id} />
  <p class="text-sm text-mute">
    <a class="hover:text-ink" href={`/tools/?category=${tool.categoryId}`}>{category?.name}</a>
  </p>
  <div class="mt-3 flex items-start justify-between gap-4">
    <h1 class="text-3xl font-semibold">{tool.name}</h1>
    <FavoriteButton client:visible toolId={tool.id} />
  </div>
  <p class="mt-3 max-w-2xl leading-7 text-mute">{tool.summary}</p>
  <section class="mt-8 rounded-3xl border border-line bg-white p-5 sm:p-6">
    {tool.id === 'nether-coords' && <NetherCoordsWidget client:load />}
    {tool.id === 'tick-time' && <TickTimeWidget client:load />}
    {tool.id === 'day-clock' && <DayClockWidget client:load />}
    {tool.id === 'xp-level' && <XpLevelWidget client:load />}
    {tool.id === 'uuid-skin' && <UuidSkinWidget client:load />}
    {tool.id === 'server-status' && <ServerStatusWidget client:load />}
    {tool.id === 'motd' && <MotdWidget client:load />}
    {tool.id === 'command-gen' && <CommandWidget client:load />}
    {tool.id === 'seed-finder' && <SeedFinderWidget client:load />}
    {tool.id === 'skin-preview' && <SkinPreviewWidget client:load />}
  </section>
  <p class="mt-4 text-sm leading-6 text-mute">{tool.detail}</p>
  {related.length > 0 && (
    <section class="mt-12">
      <h2 class="text-lg font-semibold">同分类</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {related.map((item) => (
          <li>
            <ToolCapsule id={item.id} name={item.name} summary={item.summary} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
) : (
<BaseLayout title="页面不存在" description="没有这个工具">
  <h1 class="text-3xl font-semibold">页面不存在</h1>
  <p class="mt-4 text-mute">这个地址没有对应的工具。</p>
  <a class="mt-6 inline-flex rounded-full bg-ink px-4 py-2 text-sm text-white" href="/tools/">回到工具</a>
</BaseLayout>
)}
