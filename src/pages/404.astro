---
import BaseLayout from '../layouts/BaseLayout.astro';
import {siteName} from '../tools/catalog';
---

<BaseLayout title="页面不存在" description={`${siteName}里没有这个页面`}>
  <h1 class="text-3xl font-semibold">页面不存在</h1>
  <p class="mt-4 text-mute">这个地址没有对应的工具。</p>
  <a class="mt-6 inline-flex rounded-full bg-ink px-4 py-2 text-sm text-white" href="/">
    回到首页
  </a>
</BaseLayout>
